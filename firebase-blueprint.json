{
  "entities": {
    "VendorApplication": {
      "title": "VendorApplication",
      "description": "Submitted application from a small business or vendor wishing to exhibit at the festival.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the application",
          "maxLength": 128
        },
        "businessName": {
          "type": "string",
          "description": "Registered name of the business or artisan brand",
          "maxLength": 150
        },
        "contactName": {
          "type": "string",
          "description": "Primary contact person name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 50
        },
        "website": {
          "type": "string",
          "description": "Business website, Instagram, or social link",
          "maxLength": 200
        },
        "vendorKind": {
          "type": "string",
          "description": "Vendor type classification",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Vendor product category",
          "maxLength": 100
        },
        "selectedBoothId": {
          "type": "string",
          "description": "Selected booth space tier ID",
          "maxLength": 50
        },
        "selectedDays": {
          "type": "array",
          "description": "List of festival days selected for booking (1 to 3 days)"
        },
        "productDescription": {
          "type": "string",
          "description": "Detailed description of products or services offered",
          "maxLength": 1000
        },
        "photoLinks": {
          "type": "string",
          "description": "Links or notes regarding product photos",
          "maxLength": 500
        },
        "isFoodVendor": {
          "type": "boolean",
          "description": "Whether the vendor serves food or edible items"
        },
        "hasFoodPermit": {
          "type": "boolean",
          "description": "Whether the vendor has required food permits"
        },
        "tempHygieneCompliant": {
          "type": "boolean",
          "description": "Whether food vendor is compliant with temperature and hygiene guidelines"
        },
        "needsHandicapParking": {
          "type": "boolean",
          "description": "Whether accessibility or handicap parking is requested"
        },
        "handicapNotes": {
          "type": "string",
          "description": "Special accessibility requirements",
          "maxLength": 500
        },
        "additionalRequests": {
          "type": "string",
          "description": "Any additional requests or notes",
          "maxLength": 500
        },
        "agreedToTerms": {
          "type": "boolean",
          "description": "Confirmation that vendor agreed to festival terms and conditions"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "waitlist", "paid"],
          "description": "Application review and confirmation status"
        },
        "totalCalculatedFee": {
          "type": "number",
          "description": "Total booth fee calculated based on days and tier"
        },
        "boothZoneAssignment": {
          "type": "string",
          "description": "Assigned zone or booth location on the festival map",
          "maxLength": 100
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal organizer review notes",
          "maxLength": 1000
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "paid", "waived", "pending"],
          "description": "Invoice payment status for this application"
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Associated invoice reference number",
          "maxLength": 50
        },
        "eTransferSecurityAnswer": {
          "type": "string",
          "description": "E-Transfer security question answer or confirmation details submitted by vendor",
          "maxLength": 500
        },
        "eTransferPayerEmail": {
          "type": "string",
          "description": "Sender email used for E-Transfer",
          "maxLength": 150
        },
        "eTransferSubmittedAt": {
          "type": "string",
          "description": "ISO timestamp when E-Transfer security answer was submitted",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when application was submitted",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when application was last modified",
          "maxLength": 40
        }
      },
      "required": ["businessName", "contactName", "email", "category", "selectedBoothId", "selectedDays", "status", "createdAt"]
    },
